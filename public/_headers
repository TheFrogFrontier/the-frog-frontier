# Cloudflare Pages reads this file. Images and fonts get a week of browser
# caching. The pages and site.css are always revalidated, so text, price and
# design edits show up immediately.
# If you replace an image, visitors may see the old one for up to a week.
# Rename the file (frog-teal-2.webp) to push it through straight away.

/assets/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/check-your-inbox/*
  X-Robots-Tag: noindex, nofollow
